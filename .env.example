# -------------------------------------------------------------------
# Environment variables for the Vapi + Scalekit voice demo
#
# DEMO USAGE:
#   cp .env.example .env.local
#   Fill real values. NEXT_PUBLIC_* values are readable in the browser.
#
# PRODUCTION / LIVE APPS:
#   - Identifier comes from your authenticated user (not a static env var).
#   - Mint fresh tokens at call time in your backend.
#   - Inject server.url + Authorization header into Vapi via the Vapi API
#     (using VAPI_PRIVATE_KEY) instead of manual dashboard edits.
#   - Keep SCALEKIT_CLIENT_SECRET and VAPI_PRIVATE_KEY server-only.
# -------------------------------------------------------------------

# Vapi
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key
VAPI_PRIVATE_KEY=your_vapi_private_key

# Scalekit
SCALEKIT_ENV_URL=https://your-env.scalekit.com
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=skcs_...

# Scalekit identifier
# This is the key you use to tell Scalekit "run tools as this user".
# It must match the identifier of an ACTIVE connection you have in Scalekit.
# 
# How to find it:
# 1. Go to Scalekit Dashboard → AgentKit → Connected Accounts
# 2. Find a connection that shows as "Active" (e.g. Gmail)
# 3. Copy the "Identifier" value for that connection (often an email or your user ID)
#
# For pure testing right now, use whatever identifier has at least one active connection.
TEST_IDENTIFIER=your-test-identifier-here

# Also expose the same value to the browser for the demo UI
NEXT_PUBLIC_TEST_SCALEKIT_CONNECTION_ID=your-test-identifier-here

# Optional
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Scalekit Virtual MCP (add this when using MCP mode)
SCALEKIT_MCP_CONFIG_ID=cfg_...
NEXT_PUBLIC_SCALEKIT_MCP_SERVER_URL=https://.../mcp/v3/servers/...

# LiveKit Cloud project (from `lk cloud auth` or the LiveKit Cloud dashboard)
# Used by the Next.js API route (to dispatch the agent + mint participant tokens)
# and by the agent worker process (to connect to the same LiveKit project).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
